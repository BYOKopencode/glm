# Copy to .env and edit. Every value here is a default -- nothing is required
# to boot except, optionally, auth.

# ---------------------------------------------------------------- server ---
PORT=8000
DEBUG=0

# ------------------------------------------------------------------ auth ---
# Leave both unset to run open. Set either to require a bearer token.
# Generate one with:  openssl rand -hex 32
API_KEY=pampa
# API_KEYS=key_one,key_two,key_three
# Set to 1 to refuse to start unless a key is configured (recommended in prod).
REQUIRE_AUTH=1

# ------------------------------------------------------------------ CORS ---
# Comma-separated origins, or "*" for any. Browser clients sending an
# Authorization header need their exact origin listed here -- credentialed
# requests are refused while this is "*".
ALLOWED_ORIGINS=*

# --------------------------------------------------------------- browser ---
HEADLESS=1
# Residential proxy, e.g. http://user:pass@host:port. Helps when Aliyun's
# captcha blocks datacenter IPs.
# PROXY_SERVER=
# Remote browser websocket (Bright Data Scraping Browser etc). When set, no
# local Chromium is launched or needed.
# BROWSER_CDP_URL=

# --------------------------------------------------------------- timeouts ---
NAV_TIMEOUT_MS=60000
FIRST_CHUNK_TIMEOUT_S=60
IDLE_TIMEOUT_S=120

# --------------------------------------------------------------- sessions ---
# Idle seconds before a CDP session is recycled. 0 disables reuse.
SESSION_TTL_S=120
# Hard ceiling on a single CDP session's lifetime.
SESSION_MAX_AGE_S=3000

# ------------------------------------------------------------------ model ---
SET_MODEL=1
# reasoning | hide | raw
THINK_MODE=reasoning
# Override the composer selectors if chat.z.ai changes its DOM.
# COMPOSER_SELECTORS=textarea#chat-input,textarea[placeholder]
